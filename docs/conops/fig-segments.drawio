<mxfile host="drawio">
  <diagram id="segments" name="Figure 1 - Ground and space segments">
    <mxGraphModel dx="640" dy="420" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="640" pageHeight="420" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        

        <!-- Orbit -->
        <mxCell id="orbit" value="" style="curved=1;endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="0" y="175" as="sourcePoint" />
            <mxPoint x="420" y="100" as="targetPoint" />
            <Array as="points">
              <mxPoint x="120" y="100" />
              <mxPoint x="270" y="68" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="orbitlabel" value="orbit" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontColor=#888888;" vertex="1" parent="1">
          <mxGeometry x="10" y="125" width="50" height="20" as="geometry" />
        </mxCell>

        

        <!-- Space segment -->
        <mxCell id="spacelabel" value="&lt;b&gt;Space segment&lt;/b&gt; (in orbit, out of reach)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="110" y="0" width="255" height="24" as="geometry" />
        </mxCell>
        <mxCell id="sat" value="" style="shape=mxgraph.networks.satellite;html=1;fillColor=#5A5A5A;strokeColor=#FFFFFF;outlineConnect=0;" vertex="1" parent="1">
          <mxGeometry x="235" y="35" width="70" height="70" as="geometry" />
        </mxCell>

        <!-- Inside the spacecraft -->
        <mxCell id="inside" value="&lt;b&gt;Inside the spacecraft&lt;/b&gt;" style="rounded=1;arcSize=4;dashed=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;verticalAlign=top;align=left;spacingLeft=8;spacingTop=2;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="370" y="25" width="268" height="225" as="geometry" />
        </mxCell>
        <mxCell id="obc" value="Onboard&lt;br&gt;computer" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="385" y="110" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ctl" value="Controller" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="550" y="110" width="80" height="50" as="geometry" />
        </mxCell>
        <mxCell id="i2a" value="" style="endArrow=classic;startArrow=classic;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;entryX=0;entryY=0.3;entryDx=0;entryDy=0;labelBackgroundColor=none;fontSize=13;endSize=5;startSize=5;" edge="1" parent="1" source="obc" target="ctl">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i2b" value="" style="endArrow=classic;startArrow=classic;html=1;exitX=1;exitY=0.7;exitDx=0;exitDy=0;entryX=0;entryY=0.7;entryDx=0;entryDy=0;labelBackgroundColor=none;fontSize=12;endSize=5;startSize=5;" edge="1" parent="1" source="obc" target="ctl">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="10" as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="i3" value="" style="curved=1;endArrow=classic;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;strokeWidth=2;labelBackgroundColor=#FFFFFF;fontSize=13;endSize=6;" edge="1" parent="1" source="obc" target="ctl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="508" y="212" />
            </Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="i3label" value="&lt;b&gt;Reprogramming link&lt;/b&gt;: the last resort&lt;br&gt;restores working firmware when&lt;br&gt;the controller's firmware cannot run" style="text;html=1;align=center;verticalAlign=top;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="408" y="190" width="200" height="48" as="geometry" />
        </mxCell>

        <mxCell id="zoom" value="" style="endArrow=classic;html=1;strokeColor=#777777;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.2;entryDx=0;entryDy=0;endSize=6;" edge="1" parent="1" source="sat" target="inside">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="i2label" value="&lt;b&gt;Data link&lt;/b&gt;: the normal path&lt;br&gt;commands, firmware, reports&lt;br&gt;2 separate connections" style="text;html=1;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="408" y="56" width="200" height="48" as="geometry" />
        </mxCell>

        <!-- Ground segment -->
        <mxCell id="groundlabel" value="&lt;b&gt;Ground segment&lt;/b&gt; (Earth)" style="text;html=1;align=left;verticalAlign=middle;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="10" y="208" width="220" height="24" as="geometry" />
        </mxCell>
        <mxCell id="op" value="Operator" style="shape=mxgraph.networks.user_male;html=1;fillColor=#5A5A5A;strokeColor=#FFFFFF;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="15" y="245" width="30" height="45" as="geometry" />
        </mxCell>
        <mxCell id="dish" value="Ground station" style="shape=mxgraph.networks.satellite_dish;html=1;fillColor=#5A5A5A;strokeColor=#FFFFFF;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="216" y="243" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="moc" value="Mission operations&lt;br&gt;center" style="shape=mxgraph.networks.pc;html=1;fillColor=#5A5A5A;strokeColor=#FFFFFF;outlineConnect=0;verticalLabelPosition=bottom;verticalAlign=top;labelPosition=center;align=center;fontSize=13;" vertex="1" parent="1">
          <mxGeometry x="103" y="247" width="50" height="43" as="geometry" />
        </mxCell>
        <mxCell id="opmoc" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="op" target="moc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="mocdish" value="" style="endArrow=none;html=1;" edge="1" parent="1" source="moc" target="dish">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Radio link across the gap -->
        <mxCell id="i1" value="" style="endArrow=classic;startArrow=classic;html=1;dashed=1;strokeWidth=2;endSize=6;startSize=6;" edge="1" parent="1" source="dish" target="sat">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="i1label" value="&lt;b&gt;Radio link&lt;/b&gt;&lt;br&gt;commands and firmware up,&lt;br&gt;reports down;&lt;br&gt;only during contacts" style="text;html=1;align=right;verticalAlign=middle;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="70" y="140" width="170" height="64" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
